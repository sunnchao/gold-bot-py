# Gold Bot FastAPI Full-Stack Configuration
# 由 docs/porting/snapshots/env.md 生成。真实密钥不要提交。

# Published container images (override these to pin a version or digest)
GOLDBOT_BACKEND_IMAGE=ghcr.io/sunnchao/gold-bot-py-backend:latest
GOLDBOT_FRONTEND_IMAGE=ghcr.io/sunnchao/gold-bot-py-frontend:latest

# ============================================================================
# Trading Engine (FastAPI, :8000 / published :8880)
# ============================================================================

# Database
DSN=*****************************************/goldbot?sslmode=disable
DBPath=data/gold_bolt.sqlite

# HTTP Server
HTTP_ADDR=0.0.0.0:8880

# Authentication
ADMIN_TOKEN=your_admin_token_here

# ============================================================================
# Agents (in-process LangGraph)
# ============================================================================

# Gold-bot API (GOLDBOT_API_TOKEN 需为 admin token,调度器靠它列出 EA 已注册账户)
GOLDBOT_API_URL=http://127.0.0.1:8000
GOLDBOT_API_TOKEN=your_admin_token_here

# Redis
REDIS_URL=redis://localhost:6379

# LLM Configuration
# 协议：OpenAI Chat Completions 标准（POST {LLM_BASE_URL}/chat/completions）。
# 实际部署端点：wochirou（Chirou）OpenAI 兼容网关 https://api-eo.wochirou.com/v1
# （llm-client 不再使用 Anthropic Messages API；Claude 模型也经该网关走 OpenAI 格式）
LLM_PROVIDER=openai
LLM_BASE_URL=https://api-eo.wochirou.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-v4-flash-0731
# 主模型请求失败(异常/流式空响应)时自动切换的回退模型;与 LLM_MODEL 相同则禁用回退
LLM_FALLBACK_MODEL=deepseek-v4-pro-0813
LLM_TIMEOUT=120000
LLM_MAX_RETRIES=3
# true = 按模型名探测缓存策略（claude→auto_prefix 退化、deepseek/gpt→auto_prefix、
# kimi→prompt_cache_key）；OpenAI 格式下不再发送 cache_control 字段
LLM_ENABLE_PROMPT_CACHING=false

# Analysis trigger: bar_close disables the repeatable LLM cron job.
ANALYSIS_TRIGGER_MODE=bar_close
# Used only when ANALYSIS_TRIGGER_MODE=cron.
SCHEDULE_CRON=*/30 * * * *

# Logging
LOG_LEVEL=info

# HTTP Server
PORT=3100

# ============================================================================
# Monitoring (Prometheus + Grafana)
# ============================================================================

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_change_me

# ============================================================================
# App Runtime
# ============================================================================

GB_APP_ENV=development
GB_APP_SERVER_HOST=127.0.0.1
GB_APP_SERVER_PORT=8000
GB_NODE_SHADOW_MODE=true

# Persistence (leave both empty to use in-memory store)
GB_EA_STORE_SQLITE_PATH=data/gold_bolt_node.sqlite
GB_EA_STORE_POSTGRES_DSN=

# Authentication (falls back to ADMIN_TOKEN above if unset)
GB_ADMIN_TOKEN=
GB_LEGACY_TOKENS_PATH=

# Redis (optional, for future scaling)
GB_REDIS_URL=

# Notifications
GB_DISCORD_WEBHOOK_URL=
GB_FEISHU_WEBHOOK_URL=
GB_FEISHU_SECRET=

# Signal quality (Phase 3.6): H4 ADX trend veto for technical signals.
# hard (default) = range-bound H4 blocks all entries; soft = warn only,
# downstream multi-timeframe consensus scoring decides.
GB_H4_ADX_FILTER_MODE=hard
