{
  "dashboard": {
    "uid": "gold-bot-performance",
    "title": "Gold Bot - 交易绩效",
    "tags": ["gold-bot", "performance"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "策略胜率（按策略，当前值）",
        "description": "goldbot_strategy_win_rate gauge，按 account_id/strategy 维度。数据来源：EA POST /api/trade_history 后按 closed_trades 聚合刷新。",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "goldbot_strategy_win_rate",
            "instant": true,
            "legendFormat": "{{account_id}} / {{strategy}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true,
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 0.4, "color": "yellow"},
                {"value": 0.55, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "订单胜负分布（1小时滚动，按策略 win/loss 堆叠）",
        "description": "goldbot_orders_total 按 strategy+result 堆叠（指标已带 strategy label）。",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum by (strategy, result) (increase(goldbot_orders_total[1h]))",
            "legendFormat": "{{strategy}} / {{result}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 70,
              "lineWidth": 1,
              "stacking": {"mode": "normal", "group": "A"}
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byRegexp", "options": ".*/ win$"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]
            },
            {
              "matcher": {"id": "byRegexp", "options": ".*/ loss$"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
            }
          ]
        }
      },
      {
        "id": 3,
        "title": "日盈亏曲线（1天滚动合计，USD）",
        "description": "increase(goldbot_order_profit_usd_sum[1d])。histogram 已带 strategy label，按账户+策略与品种分组。",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum by (account_id, strategy) (increase(goldbot_order_profit_usd_sum[1d]))",
            "legendFormat": "账户 {{account_id}} / {{strategy}}"
          },
          {
            "expr": "sum by (symbol) (increase(goldbot_order_profit_usd_sum[1d]))",
            "legendFormat": "{{symbol}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 0
            }
          }
        }
      },
      {
        "id": 4,
        "title": "平均每单盈亏（USD）",
        "description": "histogram _sum / _count，衡量策略期望值（每单平均利润）。按 strategy 使用面板时间范围（$__range），账户维度保留 1 天滚动作为对照。",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "sum by (strategy) (increase(goldbot_order_profit_usd_sum[$__range])) / sum by (strategy) (increase(goldbot_order_profit_usd_count[$__range]))",
            "legendFormat": "{{strategy}}"
          },
          {
            "expr": "sum by (account_id) (increase(goldbot_order_profit_usd_sum[1d])) / sum by (account_id) (increase(goldbot_order_profit_usd_count[1d]))",
            "legendFormat": "账户 {{account_id}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 0
            }
          }
        }
      },
      {
        "id": 5,
        "title": "盈亏分布热力图（USD 区间 × 时间）",
        "description": "goldbot_order_profit_usd histogram buckets（-1000 ~ +1000 USD）。R 倍数分布的代理：0 线以上为盈利单。",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "sum by (le) (increase(goldbot_order_profit_usd_bucket[1h]))",
            "format": "heatmap",
            "legendFormat": "{{le}}"
          }
        ],
        "options": {
          "calculate": false,
          "yAxis": {"unit": "currencyUSD"},
          "color": {"mode": "scheme", "scheme": "Oranges", "steps": 64},
          "cellGap": 2
        }
      },
      {
        "id": 6,
        "title": "盈亏分布（累计单数按区间）",
        "description": "累计视角的盈亏直方图（format=heatmap 已做去累积，每档为该区间单数）。",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum by (le) (goldbot_order_profit_usd_bucket)",
            "format": "heatmap",
            "instant": true,
            "legendFormat": "≤ {{le}} USD"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "basic",
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 7,
        "title": "执行质量：HTTP 错误率（4xx/5xx，按接口）",
        "description": "接口级错误率（status label 为 2xx/4xx/5xx 分类）。券商错误码维度见底部「EA 错误码趋势」面板（goldbot_command_results_total）。",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "sum by (path, status) (rate(goldbot_http_requests_total{status=~\"4xx|5xx\"}[5m]))",
            "legendFormat": "{{path}} ({{status}})"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 8,
        "title": "执行质量：亏损单占比（1小时滚动）",
        "description": "loss / (win + loss)，基于 goldbot_orders_total 的 result label。",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "sum(increase(goldbot_orders_total{result=\"loss\"}[1h])) / sum(increase(goldbot_orders_total[1h]))",
            "legendFormat": "亏损单占比"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "color": {"mode": "thresholds"},
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "thresholdsStyle": {"mode": "line"}
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0.45, "color": "yellow"},
                {"value": 0.6, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "EA 错误码趋势（1小时滚动）",
        "description": "goldbot_command_results_total 按 error_code 分组（排除成功回报 error_code='none'）。数字为券商原始错误码（如 4108、130），非数字归为 'other'。",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "sum by (error_code) (increase(goldbot_command_results_total{error_code!=\"none\"}[1h]))",
            "legendFormat": "{{error_code}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 70,
              "lineWidth": 1,
              "stacking": {"mode": "normal", "group": "A"}
            }
          }
        }
      },
      {
        "id": 10,
        "title": "命令回报成功率（1小时滚动）",
        "description": "error_code='none' 的回报占全部 /order_result 回报的比例（goldbot_command_results_total）。",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "sum(rate(goldbot_command_results_total{error_code=\"none\"}[1h])) / sum(rate(goldbot_command_results_total[1h]))",
            "legendFormat": "成功率"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "color": {"mode": "thresholds"},
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "thresholdsStyle": {"mode": "line"}
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 0.9, "color": "yellow"},
                {"value": 0.97, "color": "green"}
              ]
            }
          }
        }
      }
    ],
    "refresh": "1m",
    "time": {
      "from": "now-7d",
      "to": "now"
    }
  }
}
